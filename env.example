# Copy this file to .env.local (local) or add these in your host's
# Environment Variables settings (production). Never commit real values.

# ── Sanity CMS ───────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-13

# ── Website forms → email (Google Workspace) ─────────────────
# 8webcom.com mail is hosted on Google Workspace, so forms send through Gmail SMTP.
# SMTP_PASS must be a Google *App Password* (16 characters), not the normal login password:
#   Google Account (info@8webcom.com) → Security → 2-Step Verification (turn on)
#   → App passwords → create one named "8webcom website".
SMTP_USER=info@8webcom.com
SMTP_PASS=
# Optional: where submissions are delivered (defaults to SMTP_USER)
MAIL_TO=info@8webcom.com
# Optional: defaults shown
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
