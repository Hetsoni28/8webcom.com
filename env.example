# Copy this file to .env.local (local) or add these in your host's
# Environment Variables settings (production). Never commit real values.

# ── Sanity CMS ───────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-13

# ── Website forms → email (Google Workspace) ─────────────────
# 8webcom.com mail is hosted on Google Workspace, so forms send through Gmail SMTP.
# SMTP_PASS must be a Google *App Password* (16 characters), not the normal login password:
#   Google Account (info@8webcom.com) → Security → 2-Step Verification (turn on)
#   → App passwords → create one named "8webcom website".
SMTP_USER=info@8webcom.com
SMTP_PASS=
# Optional: where submissions are delivered (defaults to SMTP_USER)
MAIL_TO=info@8webcom.com
# Optional: defaults shown
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ── Sanity: instant updates (webhook) ───────────────────────
# Any long random string. Use the SAME value as the webhook "Secret" in
# sanity.io/manage → API → Webhooks (URL: https://www.8webcom.com/api/revalidate/ — keep the trailing slash).
SANITY_REVALIDATE_SECRET=

# ── Sanity: one-time content import (npm run seed:sanity) ────
# Token with Editor permission: sanity.io/manage → API → Tokens. Local only.
SANITY_API_TOKEN=

# ── Google reCAPTCHA v2 ("I'm not a robot" on Contact + Careers forms) ──
# google.com/recaptcha/admin → this key → Settings. Domains must include:
#   8webcom.com, 8webcom-com.vercel.app, localhost
# The checkbox shows when the site key is set; the server checks it once the secret is set too.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
